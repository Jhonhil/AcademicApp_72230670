@page "/mahasiswa"
@inject MahasiswaService MahasiswaService
@inject NavigationManager Nav

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>🎓 Daftar Mahasiswa</h3>
    <button class="btn btn-primary" @onclick="CreateMahasiswa">
        <i class="bi bi-plus-circle"></i> Tambah Mahasiswa
    </button>
</div>

@if (!string.IsNullOrEmpty(alertMessage))
{
    <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
        @alertMessage
        <button type="button" class="btn-close" @onclick="() => alertMessage = null"></button>
    </div>
}

<!-- Fitur Bonus: Search Bar Pencarian -->
<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <span class="input-group-text">🔎</span>
            <input type="text" class="form-control" placeholder="Cari berdasarkan NIM atau Nama Mahasiswa..."
                   @bind="searchTerm" @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <button class="btn btn-outline-secondary" @onclick="() => searchTerm = string.Empty">Reset</button>
            }
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center">
        <strong>Memuat data mahasiswa...</strong>
        <div class="spinner-border ms-auto text-primary" role="status" aria-hidden="true"></div>
    </div>
}
else if (FilteredAndSortedList == null || !FilteredAndSortedList.Any())
{
    <p class="text-muted"><em>Data mahasiswa tidak ditemukan.</em></p>
}
else
{
    <!-- Fitur Bonus: Header Tabel Interaktif untuk Sorting -->
    <table class="table table-bordered table-hover align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th style="cursor: pointer;" @onclick='() => SortTable("Nim")'>
                    NIM @GetSortIcon("Nim")
                </th>
                <th style="cursor: pointer;" @onclick='() => SortTable("NamaMahasiswa")'>
                    Nama Mahasiswa @GetSortIcon("NamaMahasiswa")
                </th>
                <th>Email</th>
                <th style="cursor: pointer;" @onclick='() => SortTable("Angkatan")'>
                    Angkatan @GetSortIcon("Angkatan")
                </th>
                <th style="cursor: pointer;" @onclick='() => SortTable("NamaDosenWali")'>
                    Dosen Wali @GetSortIcon("NamaDosenWali")
                </th>
                <th style="width: 160px;">Aksi</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in FilteredAndSortedList)
            {
                <tr>
                    <td><code>@item.Nim</code></td>
                    <td class="fw-bold">@item.NamaMahasiswa</td>
                    <td>@item.Email</td>
                    <td><span class="badge bg-secondary">@item.Angkatan</span></td>
                    <td><span class="badge bg-info text-dark">@item.NamaDosenWali</span></td>
                    <td>
                        <button class="btn btn-warning btn-sm me-1" @onclick="() => EditMahasiswa(item.MahasiswaId)">Edit</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteMahasiswa(item.MahasiswaId)">Hapus</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<MahasiswaModel>? mahasiswaList;
    private bool isLoading = true;
    private string? alertMessage;
    private bool isSuccess;

    // Parameter Search & Sort
    private string searchTerm = string.Empty;
    private string sortColumn = "Nim";
    private bool isAscending = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            mahasiswaList = await MahasiswaService.GetAllAsync();
        }
        catch (Exception ex)
        {
            alertMessage = "Gagal terhubung ke API: " + ex.Message;
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    // Property Terkomputasi untuk Filtering & Sorting
    private IEnumerable<MahasiswaModel> FilteredAndSortedList
    {
        get
        {
            if (mahasiswaList == null) return Enumerable.Empty<MahasiswaModel>();

            var filtered = mahasiswaList.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                filtered = filtered.Where(m =>
                    m.Nim.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    m.NamaMahasiswa.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                );
            }

            return sortColumn switch
            {
                "NamaMahasiswa" => isAscending ? filtered.OrderBy(m => m.NamaMahasiswa) : filtered.OrderByDescending(m => m.NamaMahasiswa),
                "Angkatan" => isAscending ? filtered.OrderBy(m => m.Angkatan) : filtered.OrderByDescending(m => m.Angkatan),
                "NamaDosenWali" => isAscending ? filtered.OrderBy(m => m.NamaDosenWali) : filtered.OrderByDescending(m => m.NamaDosenWali),
                _ => isAscending ? filtered.OrderBy(m => m.Nim) : filtered.OrderByDescending(m => m.Nim)
            };
        }
    }

    private void SortTable(string column)
    {
        if (sortColumn == column)
        {
            isAscending = !isAscending;
        }
        else
        {
            sortColumn = column;
            isAscending = true;
        }
    }

    private string GetSortIcon(string column)
    {
        if (sortColumn != column) return "↕️";
        return isAscending ? "🔼" : "🔽";
    }

    private void CreateMahasiswa() => Nav.NavigateTo("/mahasiswa/form");
    private void EditMahasiswa(int id) => Nav.NavigateTo($"/mahasiswa/form/{id}");

    private async Task DeleteMahasiswa(int id)
    {
        alertMessage = null;
        var res = await MahasiswaService.DeleteAsync(id);
        isSuccess = res.Success;
        alertMessage = res.Message;

        if (res.Success)
        {
            await LoadData();
        }
    }
}