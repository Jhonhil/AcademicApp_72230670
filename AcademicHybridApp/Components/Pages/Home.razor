@page "/"
@inject DosenService DosenService
@inject MahasiswaService MahasiswaService
@inject NavigationManager Nav

<div class="container mt-3">
    <div class="p-4 mb-4 bg-light rounded-3 border">
        <h1 class="display-6 fw-bold text-primary">🏫 Dashboard Akademik</h1>
        <p class="col-md-10 fs-5 text-muted">
            Selamat datang di Sistem Informasi Akademik Sederhana. Kelola data Dosen Wali dan Mahasiswa bimbingan dengan mudah dan efisien.
        </p>
    </div>

    @if (isLoading)
    {
        <div class="d-flex align-items-center my-4">
            <strong class="text-primary">Mengambil statistik data aktual dari API...</strong>
            <div class="spinner-border ms-auto text-primary" role="status" aria-hidden="true"></div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <!-- Card Dosen -->
            <div class="col-md-6">
                <div class="card h-100 border-primary shadow-sm">
                    <div class="card-body d-flex align-items-center">
                        <div class="display-4 text-primary me-3">
                            👨‍🏫
                        </div>
                        <div>
                            <h5 class="card-title text-muted mb-1">Total Dosen</h5>
                            <h2 class="card-text fw-bold">@totalDosen Orang</h2>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-top-0">
                        <button class="btn btn-outline-primary btn-sm w-100" @onclick='() => Nav.NavigateTo("/dosen")'>
                            Kelola Data Dosen &rarr;
                        </button>
                    </div>
                </div>
            </div>

            <!-- Card Mahasiswa -->
            <div class="col-md-6">
                <div class="card h-100 border-success shadow-sm">
                    <div class="card-body d-flex align-items-center">
                        <div class="display-4 text-success me-3">
                            🎓
                        </div>
                        <div>
                            <h5 class="card-title text-muted mb-1">Total Mahasiswa</h5>
                            <h2 class="card-text fw-bold">@totalMahasiswa Orang</h2>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-top-0">
                        <button class="btn btn-outline-success btn-sm w-100" @onclick='() => Nav.NavigateTo("/mahasiswa")'>
                            Kelola Data Mahasiswa &rarr;
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private int totalDosen = 0;
    private int totalMahasiswa = 0;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var listDosen = await DosenService.GetAllAsync();
            var listMahasiswa = await MahasiswaService.GetAllAsync();

            totalDosen = listDosen.Count;
            totalMahasiswa = listMahasiswa.Count;
        }
        catch
        {
            // Jika API offline, default tetap 0
        }
        finally
        {
            isLoading = false;
        }
    }
}